# The proxy shares the already-trusted Node base image. Unlike a hostname-only
# forward proxy, it pins each connection to a checked public IP address.
FROM node:24.15-bookworm-slim

COPY --chown=node:node proxy-server.mjs /usr/local/bin/sandbox-proxy
USER node
EXPOSE 8888
ENTRYPOINT ["node", "/usr/local/bin/sandbox-proxy"]
