{
  "name": "@pixpilot/coding-agent-sandbox",
  "type": "module",
  "version": "1.0.4",
  "packageManager": "pnpm@10.17.0",
  "description": "Run AI coding agents (Claude Code, OpenAI Codex, GitHub Copilot CLI) inside Docker against a dedicated Git worktree.",
  "author": "Mo Doaie <m.doaie@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/pixpilot/agent-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixpilot/agent-tools.git",
    "directory": "packages/coding-agent-sandbox"
  },
  "bugs": {
    "url": "https://github.com/pixpilot/agent-tools/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "sandbox",
    "docker",
    "git-worktree",
    "claude-code",
    "codex",
    "copilot",
    "cli"
  ],
  "sideEffects": false,
  "exports": "./src/index.ts",
  "bin": {
    "csbx": "./dist/cli.js",
    "coding-agent-sandbox": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docker"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "csbx": "./dist/cli.js",
      "coding-agent-sandbox": "./dist/cli.js"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "git clean -xdf .cache .turbo dist",
    "clean:all": "pnpm clean && git clean -xdf node_modules",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui --watch",
    "test:ui:coverage": "vitest --ui --coverage --watch --hookTimeout=30000 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.9.0",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/tsdown-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "eslint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "prettier": "@internal/prettier-config"
}
